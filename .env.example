# Copy to .env and fill in. Used by local scripts (scripts/*.py, scripts/*.sh) — never by Terraform or Lambda
# (those get their config from tfvars / Lambda env vars set by Terraform).

AWS_REGION=us-east-1
AWS_PROFILE=default

# Filled in after `terraform apply` — see `terraform output`
API_GATEWAY_URL=
RAW_BUCKET_NAME=
CURATED_BUCKET_NAME=
DB_HOST=
DB_PORT=5432
DB_NAME=ducklake_catalog
DB_USER=ducklake_app
DB_PASSWORD=

# Lambda function names (default to <name_prefix>-<function>, e.g. ducklake-maintain)
MAINTAIN_FUNCTION_NAME=ducklake-maintain
INGEST_FUNCTION_NAME=ducklake-ingest
STATE_MACHINE_ARN=
